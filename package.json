{
  "name": "souffleur",
  "version": "1.1.0",
  "description": "A hidden prompter for calls: sees your screen, hears the room, invisible to screen share",
  "main": "src/main/main.js",
  "scripts": {
    "test": "eslint . && node --test test/sse.test.js test/listen.test.js test/report.test.js test/freekey.test.js test/free-rules.test.js test/updater.test.js test/interview.test.js test/claude.test.js test/copilot.test.js",
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "debug": "SOUFFLEUR_DEBUG=1 electron .",
    "build:audio": "mkdir -p bin && swiftc -O src/native/AudioTap.swift -o bin/audiotap",
    "build:native": "mkdir -p bin && swiftc -O src/native/AudioTap.swift -o bin/audiotap",
    "dist:mac": "npm run build:native && electron-builder --mac --config electron-builder.config.js --publish never",
    "dist:win": "electron-builder --win --config electron-builder.config.js --publish never",
    "dist": "electron-builder -mw --config electron-builder.config.js --publish never",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "cask:update": "node packaging/update-cask.mjs",
    "lint": "eslint .",
    "site:update": "node packaging/update-site.mjs",
    "site:og": "node packaging/build-og.mjs"
  },
  "keywords": [],
  "author": "akshatgg",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "pdfjs-dist": "^6.3.289"
  }
}
